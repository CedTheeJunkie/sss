local selectedObject = nil
local colorZones = {}     
local currentActiveSlot = 1
local paintChanges = {}    
local originalStates = {} 

local ActingPlotResolver = require(game:GetService("ReplicatedStorage").Modules.ActingPlotResolver)

local function getPlot()
	return ActingPlotResolver.getActingPlot(player, true)
end

local function findObjectByBuildId(buildId)
	local plot = getPlot()
	if not plot then return nil end
	local buildObjects = plot:FindFirstChild("BuildObjects")
	if not buildObjects then return nil end
	for _, obj in buildObjects:GetChildren() do
		if obj:GetAttribute("BuildId") == buildId then
			return obj
		end
	end
	return nil
end

local function findColorZones(object)
	local zones = {}
	for i = 1, 4 do
		local zoneName = "Color" .. i
		local parts = {}
		-- If the object itself is a BasePart matching the zone name, include it
		-- (e.g. WallBuildService floors are bare Parts named "Color1")
		if object:IsA("BasePart") and object.Name == zoneName then
			table.insert(parts, object)
		end
		-- Collect ALL children matching the zone name, not just the first.
		-- Wall models have multiple "Color1" parts (left segment, right
		-- segment, header, sill, etc.) and all need to be painted together.
		for _, child in object:GetChildren() do
			if child.Name == zoneName then
				if child:IsA("BasePart") then
					table.insert(parts, child)
				elseif child:IsA("Model") then
					for _, desc in child:GetDescendants() do
						if desc:IsA("BasePart") then
							table.insert(parts, desc)
						end
					end
				end
			end
		end
		if #parts > 0 then
			table.insert(zones, { name = zoneName, parts = parts })
		end
	end
	return zones
end

local function storeOriginalStates()
	originalStates = {}
	for i, zone in ipairs(colorZones) do
		originalStates[i] = {}
		for _, part in zone.parts do
			table.insert(originalStates[i], {
				part = part,
				color = part.Color,
				material = part.Material,
			})
		end
	end
end

local function revertToOriginal()
	for i, zone in ipairs(colorZones) do
		if originalStates[i] then
			for _, state in originalStates[i] do
				state.part.Color = state.color
				state.part.Material = state.material
			end
		end
	end
end

local function applyPreview(slotIndex, color, textureIndex)
	local zone = colorZones[slotIndex]
	if not zone then return end
	
	if not paintChanges[slotIndex] then
		paintChanges[slotIndex] = {}
	end
	if color then
		paintChanges[slotIndex].color = color
	end
	if textureIndex then
		paintChanges[slotIndex].textureIndex = textureIndex
	end
	
	for _, part in zone.parts do
		if color then
			part.Color = color
		end
		if textureIndex then
			local texture = TEXTURES[textureIndex]
			if texture then
				part.Material = texture.material
			end
		end
	end

	local slotBtn = paintSlotsFrame:FindFirstChild("Slot_" .. slotIndex)
	if slotBtn then
		if color then
			slotBtn.BackgroundColor3 = color
		end
		if textureIndex then
			local texture = TEXTURES[textureIndex]
			if texture then
				slotBtn.Image = texture.previewImage
				if texture.previewImage == "" then
					slotBtn.ImageColor3 = texture.previewColor
				end
			end
		end
	end
end

local function clearPalette()
	for _, child in paintScrollFrame:GetChildren() do
		if child:IsA("GuiButton") then
			child:Destroy()
		end
	end
end

local function generateColorPalette()
	for i, color in ipairs(PALETTE_COLORS) do
		local btn = paintTemplate:Clone()
		btn.Name = "ColorBtn_" .. i
		btn.LayoutOrder = i
		btn.BackgroundColor3 = color
		btn.Image = ""
		btn.Parent = paintScrollFrame

		btn.Activated:Connect(function()
			applyPreview(currentActiveSlot, color, nil)
		end)
	end
end

local function generateTextureGrid()
	local baseOrder = 1001
	for i, texture in ipairs(TEXTURES) do
		local btn = textureTemplate:Clone()
		btn.Name = "TextureBtn_" .. i
		btn.LayoutOrder = baseOrder + i
		btn.Image = texture.previewImage
		btn.BackgroundColor3 = texture.previewColor
		btn.Parent = paintScrollFrame

		btn.Activated:Connect(function()
			applyPreview(currentActiveSlot, nil, i)
		end)
	end
end

local function generateSlotButtons()
	local numZones = #colorZones

	for _, child in paintSlotsFrame:GetChildren() do
		if child.Name ~= "PaintSlotTemplate" and child:IsA("GuiButton") then
			child:Destroy()
		end
	end

	if numZones <= 1 then
		paintSlotsFrame.Visible = false
		currentActiveSlot = 1
		return
	end

	paintSlotsFrame.Visible = true

	for i, zone in ipairs(colorZones) do
		local btn = paintSlotTemplate:Clone()
		btn.Name = "Slot_" .. i
		btn.Parent = paintSlotsFrame

		if zone.parts[1] then
			btn.BackgroundColor3 = zone.parts[1].Color
			local currentMat = zone.parts[1].Material
			for _, tex in ipairs(TEXTURES) do
				if tex.material == currentMat then
					btn.Image = tex.previewImage
					if tex.previewImage == "" then
						btn.ImageColor3 = tex.previewColor
					end
					break
				end
			end
		end

		local stroke = btn:FindFirstChild("UIStroke")
		if stroke then
			if i == 1 then
				stroke.Thickness = 2.5
				stroke.Color = Color3.fromRGB(255, 255, 255)
			else
				stroke.Thickness = 1
				stroke.Color = Color3.fromRGB(27, 42, 53)
			end
		end
		btn.Activated:Connect(function()
			currentActiveSlot = i

			for _, child in paintSlotsFrame:GetChildren() do
				if child:IsA("GuiButton") and child.Name ~= "PaintSlotTemplate" then
					local s = child:FindFirstChild("UIStroke")
					if s then
						s.Thickness = 1
						s.Color = Color3.fromRGB(27, 42, 53)
					end
				end
			end

			local selStroke = btn:FindFirstChild("UIStroke")
			if selStroke then
				selStroke.Thickness = 2.5
				selStroke.Color = Color3.fromRGB(255, 255, 255)
			end
		end)
	end
end

local function closePaintUI()
	paintGui.Enabled = false
	buildGui.Enabled = true
	player:SetAttribute("UseBuildCamera", true)
	clearPalette()
	selectedObject = nil
	colorZones = {}
	paintChanges = {}
	originalStates = {}
end

local function openPaintUI(buildId)
	local obj = findObjectByBuildId(buildId)
	if not obj then
		warn("[PaintClient] Could not find object with BuildId:", buildId)
		closePaintUI()
		return
	end

	selectedObject = obj
	colorZones = findColorZones(obj)

	if #colorZones == 0 then
		warn("[PaintClient] No Color zones found on", obj.Name)
		closePaintUI()
		return
	end

	storeOriginalStates()

	currentActiveSlot = 1
	paintChanges = {}

	clearPalette()
	generateColorPalette()

	textSeparator.LayoutOrder = 1000

	generateTextureGrid()
	generateSlotButtons()
end

paintCheckmark.Activated:Connect(function()
	if not selectedObject then return end

	local paintData = {}
	for i, zone in ipairs(colorZones) do
		local change = paintChanges[i]
		if change then
			local entry = {
				ZoneIndex = i 
			}
			if change.color then
				entry.Color = change.color
			end
			if change.textureIndex then
				entry.Material = TEXTURES[change.textureIndex].material
			end

			if change.color or change.textureIndex then
				table.insert(paintData, entry)
			end
		end
	end

	paintEvent:FireServer({
		ObjectId = selectedObject:GetAttribute("BuildId"),
		PaintData = paintData,
	})

	closePaintUI()
end)

paintCancel.Activated:Connect(function()
	revertToOriginal()
	closePaintUI()
end)

paintGui:GetPropertyChangedSignal("Enabled"):Connect(function()
	mainButtonsGui.Enabled = not paintGui.Enabled

	if paintGui.Enabled then
		local buildId = player:GetAttribute("PaintBuildId")
		if buildId then
			openPaintUI(buildId)
			player:SetAttribute("PaintBuildId", nil)
		else

			closePaintUI()
		end
	end
end)
