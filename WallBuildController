-- ===== GHOST PREVIEW =====

local function updateGhost(deltaTime: number)
	if not currentTool then
		destroyGhost()
		hideStartPoint()
		hideLengthLabel()
		hideSwingArrow()
		return
	end

	local plot = getPlot()
	if not plot then
		destroyGhost()
		hideStartPoint()
		hideLengthLabel()
		hideSwingArrow()
		return
	end

	if currentTool == "Wall" then
		local result = General.GetMouseResult(getGroundRaycastParams(plot))
		if not result then destroyGhost() hideStartPoint() hideLengthLabel() return end
		local snapped = snapToGrid(result.Position)

		if wallStartPos then
			local alignedPos = snapToAxis(wallStartPos, snapped)
			local cframe, size = getWallCFrame(wallStartPos, alignedPos)
			if size.Z > 0.5 then
				showGhost(size, cframe, true)
				showStartPoint(wallStartPos)
				showLengthLabel(size.Z)
			else
				destroyGhost()
				hideLengthLabel()
			end
		else
			showGhost(Vector3.new(0.5, 0.5, 0.5), CFrame.new(snapped), true)
			hideStartPoint()
			hideLengthLabel()
		end

	elseif currentTool == "Roof" then
		local result = General.GetMouseResult(getGroundRaycastParams(plot))
		if not result then destroyGhost() hideStartPoint() hideLengthLabel() hideSwingArrow() return end
		local snapped = snapToGrid(result.Position)
		local size = Vector3.new(WallBuildConfig.TileSize, WallBuildConfig.RoofThickness, WallBuildConfig.TileSize)
		local cframe = CFrame.new(snapped) * CFrame.Angles(0, math.rad(rotation), 0)
		showGhost(size, cframe, true)
		hideStartPoint()
		hideLengthLabel()
		hideSwingArrow()

	elseif currentTool == "Door" or currentTool == "Window" then
		local result = General.GetMouseResult(getWallOnlyRaycastParams(plot))
		local wallPart = result and result.Instance
		if isWallPart(wallPart) then
			local localClick = wallPart.CFrame:ToObjectSpace(CFrame.new(result.Position))
			local localZ = localClick.Z
			local height, width, yLocal, thickness
			if currentTool == "Door" then
				local doorType = WallBuildConfig.DoorTypes[currentDoorStyle or "Single"]
				height, width = doorType.height, doorType.width
				yLocal = -WallBuildConfig.WallHeight / 2 + height / 2
				thickness = doorType.thickness
			else
				local windowType = WallBuildConfig.WindowTypes[currentWindowStyle or "Standard"]
				height, width = windowType.height, windowType.width
				yLocal = -WallBuildConfig.WallHeight / 2 + windowType.sillHeight + height / 2
				thickness = windowType.thickness
			end
			local size = Vector3.new(thickness, height, width)
			local cframe = wallPart.CFrame * CFrame.new(0, yLocal, localZ)

			local wallLength = wallPart.Size.Z
			local halfWidth = width / 2
			local fits = (localZ - halfWidth >= -wallLength / 2 + 0.1) and (localZ + halfWidth <= wallLength / 2 - 0.1)
			showGhost(size, cframe, fits)

			if currentTool == "Door" and fits then
				local doorType = WallBuildConfig.DoorTypes[currentDoorStyle or "Single"]
				if doorType.swing then
					local swingSign = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) and 1 or -1
					showSwingArrow(cframe, swingSign)
				else
					hideSwingArrow()
				end
			else
				hideSwingArrow()
			end
		else
			destroyGhost()
			hideSwingArrow()
		end
		hideStartPoint()
		hideLengthLabel()
	end

	-- Smooth lerp the ghost toward its target (Bloxburg-style smooth preview)
	if ghostPart and ghostTargetCF and ghostTargetSize then
		local lerpSpeed = Settings.LerpSpeed or 15
		local alpha = 1 - math.exp(-lerpSpeed * (deltaTime or 0.016))

		if ghostVisualCF then
			ghostVisualCF = ghostVisualCF:Lerp(ghostTargetCF, alpha)
		else
			ghostVisualCF = ghostTargetCF
		end
		if ghostVisualSize then
			ghostVisualSize = ghostVisualSize:Lerp(ghostTargetSize, alpha)
		else
			ghostVisualSize = ghostTargetSize
		end

		ghostPart.CFrame = ghostVisualCF
		ghostPart.Size = ghostVisualSize
	end
end

RunService.RenderStepped:Connect(function(deltaTime)
	updateGhost(deltaTime)
end)

-- ===== INPUT & CLICK HANDLING =====

local function onClick()
	if not currentTool then return end
	local plot = getPlot()
	if not plot then return end

	if currentTool == "Wall" then
		local result = General.GetMouseResult(getGroundRaycastParams(plot))
		if not result then return end
		local snapped = snapToGrid(result.Position)

		if not wallStartPos then
			wallStartPos = snapped
		else
			local targetEndPos = snapToAxis(wallStartPos, snapped)
			local _, size = getWallCFrame(wallStartPos, targetEndPos)
			if size.Z > 0.5 then
				wallBuildEvent:FireServer("PlaceWall", { startPos = wallStartPos, endPos = targetEndPos })
				wallStartPos = targetEndPos -- Continue chain
			end
		end

	elseif currentTool == "Roof" then
		local result = General.GetMouseResult(getGroundRaycastParams(plot))
		if not result then return end
		local snapped = snapToGrid(result.Position)
		wallBuildEvent:FireServer("PlaceRoof", {
			pos = snapped,
			size = Vector3.new(WallBuildConfig.TileSize, WallBuildConfig.RoofThickness, WallBuildConfig.TileSize),
			rotation = rotation,
		})

	elseif currentTool == "Door" or currentTool == "Window" then
		local result = General.GetMouseResult(getWallOnlyRaycastParams(plot))
		local wallPart = result and result.Instance
		if isWallPart(wallPart) then
			local width
			if currentTool == "Door" then
				local doorType = WallBuildConfig.DoorTypes[currentDoorStyle or "Single"]
				width = doorType.width
			else
				local windowType = WallBuildConfig.WindowTypes[currentWindowStyle or "Standard"]
				width = windowType.width
			end
			local localZ = wallPart.CFrame:ToObjectSpace(CFrame.new(result.Position)).Z
			local wallLength = wallPart.Size.Z
			local halfWidth = width / 2
			if (localZ - halfWidth >= -wallLength / 2 + 0.1) and (localZ + halfWidth <= wallLength / 2 - 0.1) then
				if currentTool == "Door" then
					wallBuildEvent:FireServer("PlaceDoor", { wallPart = wallPart, position = result.Position, doorStyle = currentDoorStyle or "Single" })
				else
					wallBuildEvent:FireServer("PlaceWindow", { wallPart = wallPart, position = result.Position, windowStyle = currentWindowStyle or "Standard" })
				end
			end
		end
	end
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed or not currentTool then return end

	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		onClick()
	elseif input.UserInputType == Enum.UserInputType.MouseButton2 or input.KeyCode == Enum.KeyCode.Escape then
		if currentTool == "Wall" and wallStartPos then
			wallStartPos = nil
		else
			setActiveTool(nil)
		end
	elseif input.KeyCode == Enum.KeyCode.R then
		rotation = (rotation + 90) % 360
	end
end)
