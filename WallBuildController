-- ===== HELPER FUNCTIONS =====

local function getPlot(): Model?
	return ActingPlotResolver.getActingPlot(player, true)
end

local function snapToGrid(pos: Vector3): Vector3
	local gridSize = Settings.GridUnit or 1
	return Vector3.new(
		math.round(pos.X / gridSize) * gridSize,
		pos.Y,
		math.round(pos.Z / gridSize) * gridSize
	)
end

-- Locks wall along whichever axis the cursor is further along (Bloxburg style axis snap)
local function snapToAxis(startPos: Vector3, endPos: Vector3): Vector3
	local deltaX = math.abs(endPos.X - startPos.X)
	local deltaZ = math.abs(endPos.Z - startPos.Z)

	if deltaX > deltaZ then
		return Vector3.new(endPos.X, startPos.Y, startPos.Z)
	else
		return Vector3.new(startPos.X, startPos.Y, endPos.Z)
	end
end

local function isWallPart(part: Instance?): boolean
	if not part then return false end
	local buildType = part:GetAttribute("BuildType")
	return buildType == "Wall" or buildType == "WallSegment"
end

local function destroyGhost()
	if ghostPart then
		ghostPart:Destroy()
		ghostPart = nil
	end
	if ghostHighlight then
		ghostHighlight:Destroy()
		ghostHighlight = nil
	end
	if lengthBillboard then
		lengthBillboard:Destroy()
		lengthBillboard = nil
		lengthLabel = nil
	end
	if swingArrow then
		swingArrow:Destroy()
		swingArrow = nil
	end
	ghostTargetCF = nil
	ghostTargetSize = nil
	ghostVisualCF = nil
	ghostVisualSize = nil
end

local function showGhost(size: Vector3, cframe: CFrame, valid: boolean)
	if not ghostPart then
		ghostPart = Instance.new("Part")
		ghostPart.Name = "WallGhostPreview"
		ghostPart.Anchored = true
		ghostPart.CanCollide = false
		ghostPart.CanQuery = false
		ghostPart.CanTouch = false
		ghostPart.Material = Enum.Material.ForceField
		ghostPart.Transparency = WallBuildConfig.GhostTransparency
		ghostPart.Parent = workspace

		ghostVisualCF = cframe
		ghostVisualSize = size
		ghostPart.CFrame = cframe
		ghostPart.Size = size

		ghostHighlight = Instance.new("Highlight")
		ghostHighlight.FillTransparency = 0.85
		ghostHighlight.OutlineTransparency = 0
		ghostHighlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		ghostHighlight.Parent = ghostPart
	end

	ghostTargetSize = size
	ghostTargetCF = cframe

	local color = valid and WallBuildConfig.Colors.GhostValid or WallBuildConfig.Colors.GhostInvalid
	ghostPart.Color = color
	if ghostHighlight then
		ghostHighlight.FillColor = color
		ghostHighlight.OutlineColor = color
	end
end

local function showStartPoint(pos: Vector3)
	if not startPointIndicator then
		startPointIndicator = Instance.new("Part")
		startPointIndicator.Name = "WallStartPoint"
		startPointIndicator.Shape = Enum.PartType.Ball
		startPointIndicator.Size = Vector3.new(1.5, 1.5, 1.5)
		startPointIndicator.Anchored = true
		startPointIndicator.CanCollide = false
		startPointIndicator.CanQuery = false
		startPointIndicator.CanTouch = false
		startPointIndicator.Material = Enum.Material.Neon
		startPointIndicator.Color = Color3.fromRGB(100, 200, 255)
		startPointIndicator.Transparency = 0.3
		startPointIndicator.Parent = workspace
	end
	startPointIndicator.Position = pos
end

local function hideStartPoint()
	if startPointIndicator then
		startPointIndicator:Destroy()
		startPointIndicator = nil
	end
end

local function showLengthLabel(length: number)
	if not lengthBillboard then
		lengthBillboard = Instance.new("BillboardGui")
		lengthBillboard.Name = "LengthLabel"
		lengthBillboard.Size = UDim2.new(0, 120, 0, 30)
		lengthBillboard.StudsOffset = Vector3.new(0, 3, 0)
		lengthBillboard.AlwaysOnTop = true
		lengthBillboard.MaxDistance = 300
		lengthLabel = Instance.new("TextLabel")
		lengthLabel.Size = UDim2.new(1, 0, 1, 0)
		lengthLabel.BackgroundTransparency = 0.3
		lengthLabel.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
		lengthLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
		lengthLabel.TextScaled = true
		lengthLabel.Font = Enum.Font.GothamBold
		lengthLabel.Parent = lengthBillboard
		lengthBillboard.Parent = ghostPart
	end
	if lengthLabel then
		lengthLabel.Text = string.format("%.1f studs", length)
	end
end

local function hideLengthLabel()
	if lengthBillboard then
		lengthBillboard:Destroy()
		lengthBillboard = nil
		lengthLabel = nil
	end
end

local function showSwingArrow(doorCF: CFrame, swingSign: number)
	if not swingArrow then
		swingArrow = Instance.new("Part")
		swingArrow.Name = "SwingArrow"
		swingArrow.Size = Vector3.new(0.3, 0.1, 1.5)
		swingArrow.Anchored = true
		swingArrow.CanCollide = false
		swingArrow.CanQuery = false
		swingArrow.CanTouch = false
		swingArrow.Material = Enum.Material.Neon
		swingArrow.Color = Color3.fromRGB(100, 255, 100)
		swingArrow.Transparency = 0.3
		swingArrow.Parent = workspace
	end
	local doorType = WallBuildConfig.DoorTypes[currentDoorStyle or "Single"]
	local hingeOffset = CFrame.new(0, 0, swingSign * doorType.width / 2)
	swingArrow.CFrame = doorCF * hingeOffset * CFrame.Angles(0, math.rad(70 * swingSign), 0)
end

local function hideSwingArrow()
	if swingArrow then
		swingArrow:Destroy()
		swingArrow = nil
	end
end

setActiveTool = function(toolName: string?)
	currentTool = toolName
	wallStartPos = nil
	destroyGhost()
	hideStartPoint()
	hideLengthLabel()
	hideSwingArrow()
	for name, btn in pairs(toolButtons) do
		btn.ImageColor3 = (name == toolName) and Color3.fromRGB(100, 200, 255) or originalColors[name]
	end
	player:SetAttribute("WallBuildTool", toolName)
end

-- ===== RAYCAST PARAMS =====

local function getGroundRaycastParams(plot: Model): RaycastParams
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	local base = plot:FindFirstChild("Base")
	local buildObjects = plot:FindFirstChild("BuildObjects")
	local instances = {}
	if base then table.insert(instances, base) end
	if buildObjects then table.insert(instances, buildObjects) end
	params.FilterDescendantsInstances = instances
	return params
end

local function getWallOnlyRaycastParams(plot: Model): RaycastParams
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	local buildObjects = plot:FindFirstChild("BuildObjects")
	params.FilterDescendantsInstances = buildObjects and { buildObjects } or {}
	return params
end

local function getWallCFrame(pos1: Vector3, pos2: Vector3): (CFrame, Vector3)
	pos2 = Vector3.new(pos2.X, pos1.Y, pos2.Z)
	local direction = pos2 - pos1
	local length = Vector3.new(direction.X, 0, direction.Z).Magnitude
	local angle = math.atan2(direction.X, direction.Z)
	local midpoint = (pos1 + pos2) / 2
	midpoint = Vector3.new(midpoint.X, pos1.Y + WallBuildConfig.WallHeight / 2, midpoint.Z)
	return CFrame.new(midpoint) * CFrame.Angles(0, angle, 0), Vector3.new(WallBuildConfig.WallThickness, WallBuildConfig.WallHeight, length)
end

