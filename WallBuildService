local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")
local TweenService = game:GetService("TweenService")

local WallBuildConfig = require(ReplicatedStorage.Modules.WallBuildConfig)
local cachedModules = require(game:GetService("ServerScriptService").Server.CachedModules)

local remotes = ReplicatedStorage:WaitForChild("RemoteEvents")
local wallBuildEvent = remotes:WaitForChild("WallBuildAction")

local Service = {}

local wallBuildIdCounter = 100000

local function nextBuildId(): number
	wallBuildIdCounter += 1
	return wallBuildIdCounter
end

local doorRegistry: {[BasePart]: any} = {}

-- === Plot / permission helpers ===

local function isWithinPlotBounds(plot: Model, position: Vector3, marginStuds: number?): boolean
	local base = plot:FindFirstChild("Base")
	if not base or not base:IsA("BasePart") then return true end
	local plotSize: number = plot:GetAttribute("PlotSize") or 12
	local margin = marginStuds or 4
	local halfExtents = Vector3.new(plotSize / 2 + margin, base.Size.Y / 2 + 1000, plotSize / 2 + margin)
	local localPos = base.CFrame:PointToObjectSpace(position)
	return math.abs(localPos.X) <= halfExtents.X
		and math.abs(localPos.Y) <= halfExtents.Y
		and math.abs(localPos.Z) <= halfExtents.Z
end

local function getActingPlot(player: Player): Model?
	local plotService = cachedModules.Cache.PlotService
	if plotService then
		return plotService.getActingPlot(player, true)
	end
	return nil
end

local function getBuildObjects(plot: Model): Folder
	local buildObjects = plot:FindFirstChild("BuildObjects")
	if not buildObjects then
		buildObjects = Instance.new("Folder")
		buildObjects.Name = "BuildObjects"
		buildObjects.Parent = plot
	end
	return buildObjects
end

local function recordBuild(player: Player, record: {[string]: any}): number?
	local dataService = cachedModules.Cache.DataService
	local playerData = dataService and dataService.getData(player)
	if not playerData then return nil end
	playerData.WallBuildData = playerData.WallBuildData or {}
	table.insert(playerData.WallBuildData, record)
	return #playerData.WallBuildData
end

-- === Utility ===

local function createPart(name: string, size: Vector3, cframe: CFrame, color: Color3, material: Enum.Material, buildType: string): BasePart
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.CFrame = cframe
	part.Color = color
	part.Material = material
	part.Anchored = true
	part:SetAttribute("BuildType", buildType)
	return part
end

local function storeWallInfo(model: Model, cframe: CFrame, size: Vector3)
	model:SetAttribute("OrigPosX", cframe.Position.X)
	model:SetAttribute("OrigPosY", cframe.Position.Y)
	model:SetAttribute("OrigPosZ", cframe.Position.Z)
	model:SetAttribute("OrigRgtX", cframe.RightVector.X)
	model:SetAttribute("OrigRgtY", cframe.RightVector.Y)
	model:SetAttribute("OrigRgtZ", cframe.RightVector.Z)
	model:SetAttribute("OrigUpX", cframe.UpVector.X)
	model:SetAttribute("OrigUpY", cframe.UpVector.Y)
	model:SetAttribute("OrigUpZ", cframe.UpVector.Z)
	model:SetAttribute("OrigSizeX", size.X)
	model:SetAttribute("OrigSizeY", size.Y)
	model:SetAttribute("OrigSizeZ", size.Z)
end

local function getWallInfo(model: Model): (CFrame, Vector3)
	local pos = Vector3.new(model:GetAttribute("OrigPosX") or 0, model:GetAttribute("OrigPosY") or 0, model:GetAttribute("OrigPosZ") or 0)
	local right = Vector3.new(model:GetAttribute("OrigRgtX") or 1, model:GetAttribute("OrigRgtY") or 0, model:GetAttribute("OrigRgtZ") or 0)
	local up = Vector3.new(model:GetAttribute("OrigUpX") or 0, model:GetAttribute("OrigUpY") or 1, model:GetAttribute("OrigUpZ") or 0)
	local size = Vector3.new(model:GetAttribute("OrigSizeX") or 0, model:GetAttribute("OrigSizeY") or 0, model:GetAttribute("OrigSizeZ") or 0)
	return CFrame.fromMatrix(pos, right, up), size
end

local function getPaddedWallTransform(startPos: Vector3, endPos: Vector3)
	local direction = endPos - startPos
	local unitDir = direction.Unit
	local halfThick = WallBuildConfig.WallThickness / 2

	local paddedStart = startPos - (unitDir * halfThick)
	local paddedEnd = endPos + (unitDir * halfThick)

	local paddedLength = (paddedEnd - paddedStart).Magnitude
	local angle = math.atan2(direction.X, direction.Z)
	local midpoint = (paddedStart + paddedEnd) / 2
	midpoint = Vector3.new(midpoint.X, startPos.Y + WallBuildConfig.WallHeight / 2, midpoint.Z)

	local cframe = CFrame.new(midpoint) * CFrame.Angles(0, angle, 0)
	local size = Vector3.new(WallBuildConfig.WallThickness, WallBuildConfig.WallHeight, paddedLength)

	return cframe, size
end

-- === Door swing registration ===

local function registerDoorLeaf(leaf: BasePart, hingeLocalZ: number, isSliding: boolean?)
	leaf:SetAttribute("HingeLocalZ", hingeLocalZ)
	leaf:SetAttribute("ClosedCFrameOffset", true)
	doorRegistry[leaf] = { isOpen = false, closedCFrame = leaf.CFrame, isSliding = isSliding or false }
	CollectionService:AddTag(leaf, "AutoDoorLeaf")
end

local function setDoorLeafOpen(leaf: BasePart, open: boolean)
	local state = doorRegistry[leaf]
	if not state or state.isOpen == open then return end
	state.isOpen = open

	local hingeLocalZ = leaf:GetAttribute("HingeLocalZ") or 0
	local closedCFrame = state.closedCFrame
	local targetCFrame

	if state.isSliding then
		local slideSign = hingeLocalZ > 0 and 1 or -1
		local slideDistance = math.abs(hingeLocalZ) * 2
		if open then
			targetCFrame = closedCFrame * CFrame.new(0, 0, slideSign * slideDistance)
		else
			targetCFrame = closedCFrame
		end
	else
		if open then
			local hingeWorld = closedCFrame * CFrame.new(0, 0, hingeLocalZ)
			local swingSign = hingeLocalZ > 0 and -1 or 1
			targetCFrame = hingeWorld * CFrame.Angles(0, math.rad(WallBuildConfig.DoorSwingAngle * swingSign), 0) * CFrame.new(0, 0, -hingeLocalZ)
		else
			targetCFrame = closedCFrame
		end
	end

	if state.tween then state.tween:Cancel() end
	state.tween = TweenService:Create(leaf, TweenInfo.new(WallBuildConfig.DoorSwingTime, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), { CFrame = targetCFrame })
	state.tween:Play()
end

local function getAllNearbyPositions(): {Vector3}
	local positions = {}
	for _, plr in ipairs(Players:GetPlayers()) do
		local hrp = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
		if hrp then table.insert(positions, hrp.Position) end
	end
	for _, folderName in ipairs({"CustomerNPCs", "EmployeeNPCs"}) do
		local folder = workspace:FindFirstChild(folderName)
		if folder then
			for _, npc in ipairs(folder:GetChildren()) do
				local hrp = npc:FindFirstChild("HumanoidRootPart")
				if hrp then table.insert(positions, hrp.Position) end
			end
		end
	end
	return positions
end

local function doorProximityLoop()
	while true do
		task.wait(0.3)
		local positions = getAllNearbyPositions()
		for leaf, state in pairs(doorRegistry) do
			if not leaf.Parent then
				doorRegistry[leaf] = nil
				continue
			end
			local leafPos = state.closedCFrame.Position
			local near = false
			for _, pos in ipairs(positions) do
				if (pos - leafPos).Magnitude <= WallBuildConfig.AutoOpenRange then
					near = true
					break
				end
			end
			setDoorLeafOpen(leaf, near)
		end
	end
end

-- ===== WALL =====

local function placeWall(player: Player, data)
	local startPos, endPos = data.startPos, data.endPos
	if typeof(startPos) ~= "Vector3" or typeof(endPos) ~= "Vector3" then return end

	endPos = Vector3.new(endPos.X, startPos.Y, endPos.Z)
	local direction = endPos - startPos
	local length = Vector3.new(direction.X, 0, direction.Z).Magnitude
	if length < 1 then return end

	local plot = getActingPlot(player)
	if not plot then return end
	if not isWithinPlotBounds(plot, startPos) or not isWithinPlotBounds(plot, endPos) then return end

	local cframe, size = getPaddedWallTransform(startPos, endPos)

	local model = Instance.new("Model")
	model.Name = "Wall"
	model:SetAttribute("BuildType", "WallModel")
	model:SetAttribute("BuildId", nextBuildId())
	storeWallInfo(model, cframe, size)

	local wallPart = createPart("Color1", size, cframe, WallBuildConfig.Colors.Wall, WallBuildConfig.Materials.Wall, "Wall")
	wallPart.Parent = model
	model.Parent = getBuildObjects(plot)

	local recordIndex = recordBuild(player, { kind = "Wall", startPos = {startPos.X, startPos.Y, startPos.Z}, endPos = {endPos.X, endPos.Y, endPos.Z} })
	if recordIndex then
		model:SetAttribute("RecordIndex", recordIndex)
	end
end

-- ===== FLOOR / ROOF =====

local function placeFloor(player: Player, data)
	local pos, size, rot = data.pos, data.size, data.rotation or 0
	if typeof(pos) ~= "Vector3" or typeof(size) ~= "Vector3" then return end

	local plot = getActingPlot(player)
	if not plot then return end
	if not isWithinPlotBounds(plot, pos) then return end

	local cframe = CFrame.new(pos.X, pos.Y + size.Y / 2, pos.Z) * CFrame.Angles(0, math.rad(rot), 0)

	-- Group floor into a Model so PaintClient targets all tiles together via BuildId
	local floorModel = Instance.new("Model")
	floorModel.Name = "Floor"
	floorModel:SetAttribute("BuildType", "FloorModel")
	floorModel:SetAttribute("BuildId", nextBuildId())

	local part = createPart("Color1", size, cframe, WallBuildConfig.Colors.Floor, WallBuildConfig.Materials.Floor, "Floor")
	part:SetAttribute("IsFloor", true)
	CollectionService:AddTag(part, "Object_IgnoreCollision")
	part.Parent = floorModel

	floorModel.Parent = getBuildObjects(plot)

	recordBuild(player, { kind = "Floor", pos = {pos.X, pos.Y, pos.Z}, size = {size.X, size.Y, size.Z}, rotation = rot })
end

local function placeRoof(player: Player, data)
	local pos, size, rot = data.pos, data.size, data.rotation or 0
	if typeof(pos) ~= "Vector3" or typeof(size) ~= "Vector3" then return end

	local plot = getActingPlot(player)
	if not plot then return end
	if not isWithinPlotBounds(plot, pos) then return end

	local cframe = CFrame.new(pos) * CFrame.Angles(0, math.rad(rot), 0)

	local roofModel = Instance.new("Model")
	roofModel.Name = "Roof"
	roofModel:SetAttribute("BuildType", "RoofModel")
	roofModel:SetAttribute("BuildId", nextBuildId())

	local part = createPart("Color1", size, cframe, WallBuildConfig.Colors.Roof, WallBuildConfig.Materials.Roof, "Roof")
	part.Parent = roofModel

	roofModel.Parent = getBuildObjects(plot)

	recordBuild(player, { kind = "Roof", pos = {pos.X, pos.Y, pos.Z}, size = {size.X, size.Y, size.Z}, rotation = rot })
end

-- ===== DOOR =====

local function placeDoor(player: Player, data)
	local wallPart: BasePart = data.wallPart
	local position: Vector3 = data.position
	local doorStyle: string = data.doorStyle or "Single"
	local doorType = WallBuildConfig.DoorTypes[doorStyle] or WallBuildConfig.DoorTypes.Single

	if not wallPart or not wallPart.Parent then return end
	local model = wallPart.Parent
	if not model or model:GetAttribute("BuildType") ~= "WallModel" then return end
	if wallPart:GetAttribute("BuildType") ~= "Wall" then return end

	local plot
	if data._restoring then
		plot = model:FindFirstAncestorOfClass("Model")
		local plots = workspace:FindFirstChild("Plots")
		while plot and plots and plot.Parent ~= plots do
			plot = plot.Parent
		end
	else
		plot = getActingPlot(player)
		if not plot or not model:IsDescendantOf(plot) then return end
	end

	local wallCFrame, wallSize = wallPart.CFrame, wallPart.Size
	local thickness, height, length = wallSize.X, wallSize.Y, wallSize.Z
	local doorWidth, doorHeight = doorType.width, doorType.height
	if height < doorHeight then return end

	local localZ = wallCFrame:ToObjectSpace(CFrame.new(position)).Z
	local doorStartZ, doorEndZ = localZ - doorWidth / 2, localZ + doorWidth / 2
	if doorStartZ < -length / 2 + 0.1 or doorEndZ > length / 2 - 0.1 then return end

	if not model:GetAttribute("OrigSizeZ") then
		storeWallInfo(model, wallCFrame, wallSize)
	end
	wallPart:Destroy()

	local leftLength = doorStartZ + length / 2
	if leftLength > 0.1 then
		local leftCFrame = wallCFrame * CFrame.new(0, 0, (-length / 2 + doorStartZ) / 2)
		createPart("Color1", Vector3.new(thickness, height, leftLength), leftCFrame, WallBuildConfig.Colors.Wall, WallBuildConfig.Materials.Wall, "WallSegment").Parent = model
	end

	local rightLength = length / 2 - doorEndZ
	if rightLength > 0.1 then
		local rightCFrame = wallCFrame * CFrame.new(0, 0, (doorEndZ + length / 2) / 2)
		createPart("Color1", Vector3.new(thickness, height, rightLength), rightCFrame, WallBuildConfig.Colors.Wall, WallBuildConfig.Materials.Wall, "WallSegment").Parent = model
	end

	local headerHeight = height - doorHeight
	if headerHeight > 0.1 then
		local headerCFrame = wallCFrame * CFrame.new(0, doorHeight / 2, localZ)
		createPart("Color1", Vector3.new(thickness, headerHeight, doorWidth), headerCFrame, WallBuildConfig.Colors.Wall, WallBuildConfig.Materials.Wall, "WallSegment").Parent = model
	end

	local doorCenterY = -height / 2 + doorHeight / 2
	local doorThickness = (doorType.thickness or 0.2) + 0.15
	local isSliding = not doorType.swing

	if (doorType.leaves or 1) >= 2 then
		local leafWidth = doorWidth / 2
		local leftCenterZ = localZ - leafWidth / 2
		local rightCenterZ = localZ + leafWidth / 2

		local leftLeaf = createPart("Door", Vector3.new(doorThickness, doorHeight, leafWidth), wallCFrame * CFrame.new(0, doorCenterY, leftCenterZ), WallBuildConfig.Colors.DoorDefault, WallBuildConfig.Materials.Door, "Door")
		leftLeaf.Parent = model
		registerDoorLeaf(leftLeaf, -leafWidth / 2, isSliding)

		local rightLeaf = createPart("Door", Vector3.new(doorThickness, doorHeight, leafWidth), wallCFrame * CFrame.new(0, doorCenterY, rightCenterZ), WallBuildConfig.Colors.DoorDefault, WallBuildConfig.Materials.Door, "Door")
		rightLeaf.Parent = model
		registerDoorLeaf(rightLeaf, leafWidth / 2, isSliding)
	else
		local doorCFrame = wallCFrame * CFrame.new(0, doorCenterY, localZ)
		local door = createPart("Door", Vector3.new(doorThickness, doorHeight, doorWidth), doorCFrame, WallBuildConfig.Colors.DoorDefault, WallBuildConfig.Materials.Door, "Door")
		door.Parent = model
		registerDoorLeaf(door, -doorWidth / 2, isSliding)
	end

	if not data._restoring then
		recordBuild(player, { kind = "Door", wallRecordIndex = model:GetAttribute("RecordIndex"), position = {position.X, position.Y, position.Z}, doorStyle = doorStyle })
	end
end

-- ===== WINDOW =====

local function placeWindow(player: Player, data)
	local wallPart: BasePart = data.wallPart
	local position: Vector3 = data.position
	local windowStyle: string = data.windowStyle or "Standard"
	local windowType = WallBuildConfig.WindowTypes[windowStyle] or WallBuildConfig.WindowTypes.Standard

	if not wallPart or not wallPart.Parent then return end
	local model = wallPart.Parent
	if not model or model:GetAttribute("BuildType") ~= "WallModel" then return end
	if wallPart:GetAttribute("BuildType") ~= "Wall" then return end

	local plot
	if data._restoring then
		plot = model:FindFirstAncestorOfClass("Model")
		local plots = workspace:FindFirstChild("Plots")
		while plot and plots and plot.Parent ~= plots do
			plot = plot.Parent
		end
	else
		plot = getActingPlot(player)
		if not plot or not model:IsDescendantOf(plot) then return end
	end

	local wallCFrame, wallSize = wallPart.CFrame, wallPart.Size
	local thickness, height, length = wallSize.X, wallSize.Y, wallSize.Z
	local windowWidth, windowHeight, sillHeight = windowType.width, windowType.height, windowType.sillHeight
	if height < (sillHeight + windowHeight) then return end

	local localZ = wallCFrame:ToObjectSpace(CFrame.new(position)).Z
	local winStartZ, winEndZ = localZ - windowWidth / 2, localZ + windowWidth / 2
	if winStartZ < -length / 2 + 0.1 or winEndZ > length / 2 - 0.1 then return end

	if not model:GetAttribute("OrigSizeZ") then
		storeWallInfo(model, wallCFrame, wallSize)
	end
	wallPart:Destroy()

	local windowBottom = -height / 2 + sillHeight
	local windowTop = windowBottom + windowHeight

	local leftLength = winStartZ + length / 2
	if leftLength > 0.1 then
		local leftCFrame = wallCFrame * CFrame.new(0, 0, (-length / 2 + winStartZ) / 2)
		createPart("Color1", Vector3.new(thickness, height, leftLength), leftCFrame, WallBuildConfig.Colors.Wall, WallBuildConfig.Materials.Wall, "WallSegment").Parent = model
	end

	local rightLength = length / 2 - winEndZ
	if rightLength > 0.1 then
		local rightCFrame = wallCFrame * CFrame.new(0, 0, (winEndZ + length / 2) / 2)
		createPart("Color1", Vector3.new(thickness, height, rightLength), rightCFrame, WallBuildConfig.Colors.Wall, WallBuildConfig.Materials.Wall, "WallSegment").Parent = model
	end

	if sillHeight > 0.1 then
		local sillCFrame = wallCFrame * CFrame.new(0, -height / 2 + sillHeight / 2, localZ)
		createPart("Color1", Vector3.new(thickness, sillHeight, windowWidth), sillCFrame, WallBuildConfig.Colors.Wall, WallBuildConfig.Materials.Wall, "WallSegment").Parent = model
	end

	local aboveHeight = height / 2 - windowTop
	if aboveHeight > 0.1 then
		local aboveCFrame = wallCFrame * CFrame.new(0, (windowTop + height / 2) / 2, localZ)
		createPart("Color1", Vector3.new(thickness, aboveHeight, windowWidth), aboveCFrame, WallBuildConfig.Colors.Wall, WallBuildConfig.Materials.Wall, "WallSegment").Parent = model
	end

	local windowThickness = (windowType.thickness or 0.15) + 0.15
	local windowCFrame = wallCFrame * CFrame.new(0, windowBottom + windowHeight / 2, localZ)
	local window = createPart("Window", Vector3.new(windowThickness, windowHeight, windowWidth), windowCFrame, WallBuildConfig.Colors.Window, WallBuildConfig.Materials.Window, "Window")
	window.Transparency = 0.3
	window.Parent = model

	if not data._restoring then
		recordBuild(player, { kind = "Window", wallRecordIndex = model:GetAttribute("RecordIndex"), position = {position.X, position.Y, position.Z}, windowStyle = windowStyle })
	end
end

-- ===== DELETE / STITCH =====

local function stitchWall(model: Model)
	local origCFrame, origSize = getWallInfo(model)
	if origSize.Z < 0.1 then return end

	for _, child in ipairs(model:GetChildren()) do
		if child:IsA("BasePart") then
			doorRegistry[child] = nil
			child:Destroy()
		end
	end

	createPart("Color1", origSize, origCFrame, WallBuildConfig.Colors.Wall, WallBuildConfig.Materials.Wall, "Wall").Parent = model
end

local function deleteBuild(player: Player, data)
	local part: BasePart = data.part
	if not part or not part.Parent then return end

	local plot = getActingPlot(player)
	if not plot or not part:IsDescendantOf(plot) then return end

	local buildType = part:GetAttribute("BuildType")
	if not buildType then return end

	local model = part.Parent

	if buildType == "Wall" then
		if model:IsA("Model") and model:GetAttribute("BuildType") == "WallModel" then
			model:Destroy()
		else
			part:Destroy()
		end
	elseif buildType == "Door" or buildType == "Window" or buildType == "WallSegment" then
		if model:IsA("Model") and model:GetAttribute("BuildType") == "WallModel" then
			stitchWall(model)
		else
			part:Destroy()
		end
	elseif buildType == "Floor" or buildType == "Roof" then
		if model:IsA("Model") and (model:GetAttribute("BuildType") == "FloorModel" or model:GetAttribute("BuildType") == "RoofModel") then
			model:Destroy()
		else
			part:Destroy()
		end
	end
end

-- ===== RESTORE =====

local function reconstructWall(plot: Model, record): Model?
	local startPos = Vector3.new(record.startPos[1], record.startPos[2], record.startPos[3])
	local endPos = Vector3.new(record.endPos[1], record.endPos[2], record.endPos[3])
	local direction = endPos - startPos
	local length = Vector3.new(direction.X, 0, direction.Z).Magnitude
	if length < 1 then return nil end

	local cframe, size = getPaddedWallTransform(startPos, endPos)

	local model = Instance.new("Model")
	model.Name = "Wall"
	model:SetAttribute("BuildType", "WallModel")
	model:SetAttribute("BuildId", nextBuildId())
	storeWallInfo(model, cframe, size)

	createPart("Color1", size, cframe, WallBuildConfig.Colors.Wall, WallBuildConfig.Materials.Wall, "Wall").Parent = model
	model.Parent = getBuildObjects(plot)
	return model
end

local function reconstructFloor(plot: Model, record)
	local pos = Vector3.new(record.pos[1], record.pos[2], record.pos[3])
	local size = Vector3.new(record.size[1], record.size[2], record.size[3])
	local cframe = CFrame.new(pos.X, pos.Y + size.Y / 2, pos.Z) * CFrame.Angles(0, math.rad(record.rotation or 0), 0)

	local floorModel = Instance.new("Model")
	floorModel.Name = "Floor"
	floorModel:SetAttribute("BuildType", "FloorModel")
	floorModel:SetAttribute("BuildId", nextBuildId())

	local part = createPart("Color1", size, cframe, WallBuildConfig.Colors.Floor, WallBuildConfig.Materials.Floor, "Floor")
	part:SetAttribute("IsFloor", true)
	CollectionService:AddTag(part, "Object_IgnoreCollision")
	part.Parent = floorModel

	floorModel.Parent = getBuildObjects(plot)
end

local function reconstructRoof(plot: Model, record)
	local pos = Vector3.new(record.pos[1], record.pos[2], record.pos[3])
	local size = Vector3.new(record.size[1], record.size[2], record.size[3])
	local cframe = CFrame.new(pos) * CFrame.Angles(0, math.rad(record.rotation or 0), 0)

	local roofModel = Instance.new("Model")
	roofModel.Name = "Roof"
	roofModel:SetAttribute("BuildType", "RoofModel")
	roofModel:SetAttribute("BuildId", nextBuildId())

	local roofPart = createPart("Color1", size, cframe, WallBuildConfig.Colors.Roof, WallBuildConfig.Materials.Roof, "Roof")
	roofPart.Parent = roofModel

	roofModel.Parent = getBuildObjects(plot)
end

local function findWallPart(model: Model): BasePart?
	for _, child in ipairs(model:GetChildren()) do
		if child:IsA("BasePart") and child:GetAttribute("BuildType") == "Wall" then
			return child
		end
	end
	return nil
end

local function reconstructDoor(model: Model, record)
	local wallPart = findWallPart(model)
	if not wallPart then return end
	placeDoor(nil :: any, {
		wallPart = wallPart,
		position = Vector3.new(record.position[1], record.position[2], record.position[3]),
		doorStyle = record.doorStyle or "Single",
		_restoring = true,
	})
end

local function reconstructWindow(model: Model, record)
	local wallPart = findWallPart(model)
	if not wallPart then return end
	placeWindow(nil :: any, {
		wallPart = wallPart,
		position = Vector3.new(record.position[1], record.position[2], record.position[3]),
		windowStyle = record.windowStyle or "Standard",
		_restoring = true,
	})
end

function Service.restoreWallBuilds(player: Player, plot: Model)
	local dataService = cachedModules.Cache.DataService
	local playerData = dataService and dataService.getData(player)
	if not playerData or not playerData.WallBuildData then return end

	local wallModelsByIndex: {[number]: Model} = {}

	for i, record in ipairs(playerData.WallBuildData) do
		if record.kind == "Wall" then
			local model = reconstructWall(plot, record)
			if model then
				model:SetAttribute("RecordIndex", i)
				wallModelsByIndex[i] = model
			end
		elseif record.kind == "Floor" then
			reconstructFloor(plot, record)
		elseif record.kind == "Roof" then
			reconstructRoof(plot, record)
		elseif record.kind == "Door" and record.wallRecordIndex then
			local model = wallModelsByIndex[record.wallRecordIndex]
			if model then reconstructDoor(model, record) end
		elseif record.kind == "Window" and record.wallRecordIndex then
			local model = wallModelsByIndex[record.wallRecordIndex]
			if model then reconstructWindow(model, record) end
		end
	end
end

function Service.deleteBuildViaPart(player: Player, part: BasePart)
	deleteBuild(player, { part = part })
end

function Service.init()
	wallBuildEvent.OnServerEvent:Connect(function(player: Player, action: string, data: any)
		data = data or {}
		local rateLimiter = cachedModules.Cache.RateLimiter
		if rateLimiter and not rateLimiter.guard(player, "WallBuildAction", 15, 5) then return end

		if action == "PlaceWall" then
			placeWall(player, data)
		elseif action == "PlaceFloor" then
			placeFloor(player, data)
		elseif action == "PlaceRoof" then
			placeRoof(player, data)
		elseif action == "PlaceDoor" then
			placeDoor(player, data)
		elseif action == "PlaceWindow" then
			placeWindow(player, data)
		elseif action == "Delete" then
			deleteBuild(player, data)
		end
	end)

	task.spawn(doorProximityLoop)
end

return Service
